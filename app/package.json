{
  "name": "app2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "setup": "npm install && npm run rebuild",
    "dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron electron/main.js\"",
    "build": "next build",
    "start": "cross-env NODE_ENV=production electron electron/main.js",
    "preview": "npx serve -s out",
    "electron": "PYTHON_PATH=$(which python) concurrently \"next dev\" \"wait-on http://localhost:3000 && electron electron/main.js\""
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "lucide-react": "^0.483.0",
    "next": "^15.2.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-draggable": "^4.4.6",
    "reactflow": "^11.11.4",
    "recharts": "^2.15.1",
    "serve-static": "^1.15.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/react": "19.0.10",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9",
    "eslint-config-next": "15.2.1",
    "license-checker": "^25.0.1",
    "tailwindcss": "^4",
    "wait-on": "^8.0.2"
  }
}
